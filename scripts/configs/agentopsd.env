# =====================================================================
# AgentOPSD 8B 训练稳定性实验 —— 默认配置
# 所有变量都可在命令行/环境变量覆盖:
#   AGENTOPSD_CONFIG=/path/to/my.env bash scripts/train.sh
#   SEED=1 TRAIN_STEPS=50 bash scripts/train.sh
# =====================================================================

# ---- 服务器 git remote（ssh）----
# 例如 ssh://user@server/~/git/AgentOPSD.git 或 server:~/git/AgentOPSD.git
AGENTOPSD_GIT_REMOTE=${AGENTOPSD_GIT_REMOTE:-}

# ---- 路径 ----
DATA_ROOT=${DATA_ROOT:-$HOME/data}
MODEL_CACHE=${MODEL_CACHE:-$HOME/models}
SDAR_ROOT=${SDAR_ROOT:-$AGENTOPSD_REPO_ROOT/vendor/SDAR}
CHECKPOINT_ROOT=${CHECKPOINT_ROOT:-$AGENTOPSD_REPO_ROOT/checkpoints}
LOG_ROOT=${LOG_ROOT:-$AGENTOPSD_REPO_ROOT/logs}

# ---- conda / uv ----
CONDA_ENV=${CONDA_ENV:-CUDA-12-conda}        # 服务器已有的 CUDA12 环境名

# ---- 硬件（默认第 2~5 张 A800，最多 4 卡，最少 2 卡）----
CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-2,3,4,5}
N_GPUS=${N_GPUS:-}                        # 留空则由 CUDA_VISIBLE_DEVICES 推导
TP_SIZE=${TP_SIZE:-2}                        # vLLM tensor parallel
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.6}
MICRO_BATCH_PER_GPU=${MICRO_BATCH_PER_GPU:-16}  # 8B 在 A800 上的安全值，OOM 时调小
ENV_CPUS=${ENV_CPUS:-0.1}                    # 每个环境 worker 的 CPU 配额
RAY_NUM_CPUS=${RAY_NUM_CPUS:-}               # 留空 = ray 使用全部 CPU

# ---- 模型 / 数据 ----
MODEL_NAME=${MODEL_NAME:-Qwen/Qwen3-8B-Instruct}   # 8B 目标模型（可换 Qwen2.5-7B-Instruct）
ENV_NAME=${ENV_NAME:-alfworld}                # alfworld | webshop | search
TRAIN_TASKS=${TRAIN_TASKS:-16}                # 每个训练 step 的任务数
VAL_TASKS=${VAL_TASKS:-128}                   # 验证任务数
GROUP_SIZE=${GROUP_SIZE:-8}                   # 每个任务的 rollout 数（GRPO 组大小）
TRAIN_STEPS=${TRAIN_STEPS:-150}
MAX_PROMPT_LENGTH=${MAX_PROMPT_LENGTH:-2048}
MAX_RESPONSE_LENGTH=${MAX_RESPONSE_LENGTH:-512}
MAX_STEPS=${MAX_STEPS:-50}                    # 单幕最大交互轮数
LR=${LR:-1e-6}
KL_COEF=${KL_COEF:-0.01}
PPO_MINI_BATCH=${PPO_MINI_BATCH:-256}
PPO_CLIP_HIGH=${PPO_CLIP_HIGH:-0.24}          # AgentOPSD paper Table 3
SEED=${SEED:-0}

# ---- AgentOPSD 核心超参（论文 Table 3，单一共享配置）----
AGENTOPSD_ENABLE=${AGENTOPSD_ENABLE:-1}       # 0 = 退化为 vanilla GRPO
AGENTOPSD_LAM=${AGENTOPSD_LAM:-0.5}           # λ：整形强度，0 = 纯 GRPO
AGENTOPSD_B=${AGENTOPSD_B:-0.2}               # b：乘子带宽
AGENTOPSD_GAMMA=${AGENTOPSD_GAMMA:-0.95}      # γ：证据衰减
AGENTOPSD_EPS0=${AGENTOPSD_EPS0:-0.0001}      # ε0：先验裁剪（论文 Table 3）
AGENTOPSD_SUCCESS_THRESHOLD=${AGENTOPSD_SUCCESS_THRESHOLD:-0.5}
# 各环境奖励刻度不同: alfworld=0/10 -> 0.5; webshop score 0~1 -> 0.5;
# search 0/1 -> 0.5（如 reward 为 1 分制，保持 0.5 即可）
SKILL_ALL=${SKILL_ALL:-false}                 # teacher 是否拼接全部技能

# ---- 断点续训 ----
# auto        : 自动从 checkpoints 下最近的 global_step_* 续训，没有则从头
# resume_path : 必须配合 RESUME_CKPT
# disable     : 强制从头训练
RESUME_MODE=${RESUME_MODE:-auto}
RESUME_CKPT=${RESUME_CKPT:-}
SAVE_FREQ=${SAVE_FREQ:-10}                    # 每 N 步存一个断点（续训的基础）
TEST_FREQ=${TEST_FREQ:-5}                     # 每 N 步跑一次验证集
EXPERIMENT_NAME=${EXPERIMENT_NAME:-}

# ---- 日志 ----
WANDB_PROJECT=${WANDB_PROJECT:-agentopsd-8b-stability}
WANDB_API_KEY=${WANDB_API_KEY:-}

# ---- 镜像（下载模型/数据集时使用）----
HF_ENDPOINT=${HF_ENDPOINT:-https://hf-mirror.com}
MODELSCOPE_ENABLED=${MODELSCOPE_ENABLED:-0}
